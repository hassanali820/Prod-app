# Supabase-compatible routes (same paths as Supabase Cloud: /auth/v1, /rest/v1)
(supabase) {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
}

# Public site. Local: ":80" (plain HTTP). Production: the domain -> automatic HTTPS.
{$SITE_ADDRESS} {
	encode gzip
	request_body {
		max_size 25MB
	}
	import supabase
	handle {
		reverse_proxy app:3000 {
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}
}

# Internal-only endpoint the app server uses (SUPABASE_URL=http://caddy:8000). Not published.
:8000 {
	import supabase
}
