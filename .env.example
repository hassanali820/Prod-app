# Port the website is served on (http://localhost:$APP_PORT)
APP_PORT=80

# ---- Database
POSTGRES_USER=gerlinx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gerlinx

# ---- Backend
# Secret for login tokens. Use a long random value: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the site (Stripe redirects, reset links). Empty = taken from the browser.
SITE_URL=

# ---- Payments (Stripe). MOCK_STRIPE=true shows a fake €1 checkout page.
MOCK_STRIPE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AI grading (Gemini). MOCK_GEMINI=true uses built-in questions and a simulated score.
MOCK_GEMINI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# ---- Email (Gmail App Password). Empty = emails are printed to the backend log.
ADMIN_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
