# =====================================================================
#  GerLinx Sprachtest — environment
#  Generate fresh DB/JWT secrets anytime with:  node scripts/generate-keys.js
#  (changing them after first start requires: docker compose down -v)
# =====================================================================

# ---------- Site / proxy ----------
# Local test:  SITE_URL=http://localhost:8080  SITE_ADDRESS=:80  HTTP_PORT=8080  HTTPS_PORT=8443
# Production:  SITE_URL=https://sprachtest.gerlinx.de  SITE_ADDRESS=sprachtest.gerlinx.de  HTTP_PORT=80  HTTPS_PORT=443
SITE_URL=http://localhost:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# ---------- Test mode (no real payment / no real AI) ----------
MOCK_STRIPE=true
MOCK_GEMINI=true

# ---------- Self-hosted database + auth (local Supabase stack) ----------
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-run-scripts-generate-keys
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server -> internal proxy.  Browser -> the public site URL.
SUPABASE_URL=http://caddy:8000
SUPABASE_PUBLIC_URL=http://localhost:8080
# (To use Supabase Cloud instead: set both URLs to https://xxx.supabase.co and use its keys)
AUTH_AUTOCONFIRM=true

# ---------- Google Gemini (used when MOCK_GEMINI=false) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# ---------- Stripe (used when MOCK_STRIPE=false) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Email ----------
# Admin report recipient
ADMIN_GMAIL=admin@gerlinx.local
MAIL_FROM=sprachtest@gerlinx.local
# Local: Mailpit catches all mail -> http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Production: fill these and Gmail is used instead of SMTP_HOST
GMAIL_USER=
GMAIL_APP_PASSWORD=
